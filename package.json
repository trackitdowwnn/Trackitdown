{
  "name": "trackitdown",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@shopify/flash-list": "2.3.2",
    "@stripe/stripe-react-native": "0.81.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.21",
    "expo-apple-authentication": "~58.0.2",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.19",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "~0.88.1",
    "@react-native/metro-config": "~0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "jimp-compact": "0.16.1",
    "prettier": "^3.9.10",
    "supabase": "2.109.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc -p supabase/tests/tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p supabase/tests/tsconfig.json --noEmit",
    "test": "jest",
    "test:assets": "node --test scripts/brand/*.test.mjs",
    "test:taxonomy": "node --test scripts/carTaxonomy.test.mjs",
    "test:demo-photos": "node --test scripts/demo-photos/lib.test.mjs scripts/demo-photos/edit.test.mjs",
    "demo-photos:find": "node --use-system-ca scripts/demo-photos/find.mjs",
    "demo-photos:apply": "node --use-system-ca scripts/demo-photos/apply.mjs",
    "taxonomy:build": "node scripts/build-car-taxonomy.mjs",
    "test:db": "bash scripts/test-db.sh",
    "preflight": "node --use-system-ca scripts/preflight.mjs",
    "preflight:ci": "node scripts/preflight.mjs --offline",
    "legal:export": "node --experimental-strip-types scripts/export-legal.mjs",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "emulator": "powershell -ExecutionPolicy Bypass -File scripts/start-emulator.ps1"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "testTimeout": 15000,
    "globalSetup": "<rootDir>/jest/globalSetup.js",
    "setupFiles": [
      "<rootDir>/node_modules/react-native-gesture-handler/jestSetup.js",
      "<rootDir>/jest/webviewMock.js",
      "<rootDir>/jest/assetRegistryMock.js",
      "<rootDir>/jest/gestureRootMock.js",
      "<rootDir>/jest/quietLogger.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 75,
        "branches": 68,
        "functions": 71,
        "lines": 76
      }
    },
    "moduleNameMapper": {
      "^react-native-worklets$": "<rootDir>/node_modules/react-native-worklets/lib/module/mock.js",
      "^react-native-reanimated$": "<rootDir>/jest/reanimatedMock.js",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@shopify/flash-list))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.test\\.mjs$"
    ]
  }
}
